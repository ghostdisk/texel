{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang-vulkan",
      "displayName": "Clang + Vulkan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-vulkan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/clang.cmake",
        "IMGED_VULKAN": "ON"
      }
    },
    {
      "name": "clang-cpu",
      "displayName": "Clang + CPU",
      "inherits": "clang-vulkan",
      "binaryDir": "${sourceDir}/build/clang-cpu",
      "cacheVariables": {
        "IMGED_VULKAN": "OFF"
      }
    },
    {
      "name": "clang-vulkan-release",
      "displayName": "Clang + Vulkan distribution",
      "inherits": "clang-vulkan",
      "binaryDir": "${sourceDir}/build/clang-vulkan-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_C_FLAGS_MINSIZEREL": "/O1 /Ob1 /DNDEBUG /Gy /Gw",
        "CMAKE_CXX_FLAGS_MINSIZEREL": "/O1 /Ob1 /DNDEBUG /Gy /Gw",
        "CMAKE_EXE_LINKER_FLAGS_MINSIZEREL": "/INCREMENTAL:NO /OPT:REF /OPT:ICF",
        "CMAKE_SHARED_LINKER_FLAGS_MINSIZEREL": "/INCREMENTAL:NO /OPT:REF /OPT:ICF",
        "IMGED_PACKAGE_RUNTIME": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "BUILD_SHARED_LIBS": "OFF",
        "SD_BUILD_SHARED_LIBS": "OFF",
        "SD_BUILD_SHARED_GGML_LIB": "OFF",
        "GGML_NATIVE": "OFF",
        "GGML_AVX": "OFF",
        "GGML_AVX2": "OFF",
        "GGML_FMA": "OFF",
        "GGML_F16C": "OFF",
        "GGML_AVX512": "OFF"
      }
    },
    {
      "name": "clang-cpu-release",
      "displayName": "Clang + CPU distribution",
      "inherits": "clang-vulkan-release",
      "binaryDir": "${sourceDir}/build/clang-cpu-release",
      "cacheVariables": {
        "IMGED_VULKAN": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-vulkan",
      "configurePreset": "clang-vulkan",
      "jobs": 2
    },
    {
      "name": "clang-cpu",
      "configurePreset": "clang-cpu",
      "jobs": 2
    },
    {
      "name": "clang-vulkan-release",
      "configurePreset": "clang-vulkan-release",
      "jobs": 2
    },
    {
      "name": "clang-cpu-release",
      "configurePreset": "clang-cpu-release",
      "jobs": 2
    }
  ]
}
